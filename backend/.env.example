# Local development only. In Render, add these under Environment Variables.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE_NAME?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
PORT=5000
NODE_ENV=development
# Leave empty when frontend and backend are served together.
# For a separate frontend, enter its URL. Multiple URLs can be comma-separated.
CLIENT_ORIGIN=

# Seed control
# Set to "true" to seed demo merchants, services, and accounts on startup.
# Leave unset or "false" in production.
SEED_DEMO_DATA=false

# Passwords for seeded accounts (only used when SEED_DEMO_DATA=true).
# Change these before deploying to any shared environment.
ADMIN_PASSWORD=change_me_admin_password
SHOP_OWNER_PASSWORD=change_me_shop_owner_password
